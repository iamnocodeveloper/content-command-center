# =============================================================================
# Content Command Center · variables de entorno
# =============================================================================
# Copia este archivo a `.env.local` y rellena los valores.
# NUNCA subas `.env.local` al repositorio.
#
# TODAS las credenciales de este archivo son OPCIONALES: pueden introducirse
# desde la interfaz, en la página /settings, que las guarda en
# `.data/settings.json` (permisos 0600) y nunca las devuelve al navegador.
#
# Precedencia: valor guardado en /settings  >  variable de entorno  >  defecto.
#
# Recomendación: en producción (Vercel, contenedores con disco efímero) usa
# variables de entorno; en local o VPS con disco persistente, el panel.
# =============================================================================

# --- Sitio ------------------------------------------------------------------
# URL pública del despliegue. Se usa como metadataBase para las imágenes de
# previsualización social (Open Graph / Twitter Card).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Zernio -----------------------------------------------------------------
# https://zernio.com/dashboard/api-keys  (formato: sk_ seguido de 64 hex)
ZERNIO_API_KEY=

# Perfil/workspace de Zernio que agrupa las cuentas de @nocodeveloper.
# Se obtiene con POST /v1/profiles -> profile._id
ZERNIO_PROFILE_ID=

# Timezone IANA usado por defecto al programar contenido.
ZERNIO_DEFAULT_TIMEZONE=America/Mexico_City

# Sobrescribe la base de la API (útil para pruebas o proxies).
# ZERNIO_BASE_URL=https://zernio.com/api/v1

# --- Modo de datos ----------------------------------------------------------
# En /settings se controla con "auto | on | off" y esa elección manda siempre.
#
#   auto (defecto) -> datos en vivo EN CUANTO hay ZERNIO_API_KEY (o una clave
#                     guardada desde el panel). Sin credencial, demo.
#   on             -> fuerza datos semilla (opción del panel).
#   off            -> fuerza datos en vivo.
#
# Esta variable sólo actúa como señal en un sentido: DEMO_MODE=false fuerza
# datos en vivo. DEMO_MODE=true es el valor por defecto y NO fuerza la demo:
# significa «demo si no hay credenciales». Si quieres forzarla, usa "on".
DEMO_MODE=true

# --- Modelo de IA (guiones, captions, hooks) --------------------------------
# Provider: "heuristic" | "openai" | "anthropic" | "aisa"
#   heuristic -> plantillas locales, sin coste ni red (por defecto)
CAPTION_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Carruseles: visión para el guion y GPT Image para imágenes completas.
# El modelo de imágenes debe admitir el formato 4:5 (1024x1280).
OPENAI_CAROUSEL_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# AIsa — gateway multi-modelo compatible con OpenAI.
# Un solo token da acceso a 108 modelos (GPT, Claude, Gemini, Grok, DeepSeek,
# Qwen, Kimi, MiniMax, GLM…). Crea la clave en https://console.aisa.one; tiene
# formato sk-aisa-… y se factura contra el saldo de la cuenta.
# Catálogo de IDs exactos: https://aisa.one/docs/guides/models
AISA_API_KEY=
AISA_MODEL=gpt-5.4
# Sobrescribe la raíz de la API (útil para pruebas o proxies).
# AISA_BASE_URL=https://api.aisa.one/v1

# --- Transcripción (hooks de competidores) ----------------------------------
# Provider: "mock" | "openai" | "deepgram"
#   openai -> reutiliza OPENAI_API_KEY (Whisper)
TRANSCRIPTION_PROVIDER=mock
DEEPGRAM_API_KEY=

# --- Ingesta automática -----------------------------------------------------
# Protege /api/cron/* en producción. Vercel Cron lo envía como
# `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# --- Almacenamiento local ---------------------------------------------------
# Directorio donde se guarda settings.json y el estado del store en memoria.
DATA_DIR=.data

# --- Base de datos (opcional, recomendado en producción) --------------------
# Si se define, el repositorio puede usar Postgres en lugar del store en
# memoria. Ver docs/03-bases-de-datos.md.
# DATABASE_URL=postgres://user:pass@host:5432/content_center
